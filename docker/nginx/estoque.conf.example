# Exemplo para o Nginx que já existe na VPS (docs/08 §5). Troque o domínio e use o mesmo esquema de certificado.
# (A) Nginx em container na mesma rede do app: proxy_pass http://estoque-app:3000
# (B) Nginx no host com o app publicado em 127.0.0.1:3010: proxy_pass http://127.0.0.1:3010
server {
  listen 443 ssl http2;
  server_name estoque.seudominio.com.br;
  # ssl_certificate     /caminho/fullchain.pem;
  # ssl_certificate_key /caminho/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000" always;
  client_max_body_size 10m;   # importação de planilha

  location / {
    proxy_pass http://estoque-app:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;   # o limite de tentativas de login usa este IP
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 80;
  server_name estoque.seudominio.com.br;
  return 301 https://$host$request_uri;
}
